{
    "name": "next-base",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24.0.0",
        "npm": "^11.0.0"
    },
    "packageManager": "npm@11.19.1",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "architecture": "node tools/architecture.mjs",
        "test:architecture": "node tools/architecture-tests.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:coverage:negative": "node tools/coverage-negative.mjs",
        "browser:install": "playwright install --with-deps chromium",
        "test:browser": "tsx tests/browser/run.ts"
    },
    "dependencies": {
        "@ant-design/icons": "6.1.0",
        "@tanstack/react-query": "5.91.2",
        "@tanstack/react-query-devtools": "5.91.3",
        "antd": "6.0.0",
        "axios": "1.16.1",
        "dayjs": "1.11.19",
        "next": "16.2.10",
        "react": "19.2.0",
        "react-dom": "19.2.0"
    },
    "devDependencies": {
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "20.19.25",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@vitest/coverage-v8": "4.1.11",
        "dependency-cruiser": "17.3.1",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.10",
        "jsdom": "27.4.0",
        "playwright": "1.57.0",
        "prettier": "3.7.2",
        "tsx": "4.20.6",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    }
}
